{
  "name": "Church Notes",
  "short_name": "Church Notes",
  "description": "Record the message, catch the verses and songs, and keep every announcement from church.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#f6efe3",
  "theme_color": "#f6efe3",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Record the message", "short_name": "Record", "url": "./?go=record", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Quick verse", "short_name": "Verse", "url": "./?go=verse", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Quick song", "short_name": "Song", "url": "./?go=song", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Write a note", "short_name": "Note", "url": "./?go=note", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "share_target": {
    "action": "./share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [{ "name": "files", "accept": ["audio/*", "image/*", "video/*", "application/pdf", "text/plain", ".m4a", ".amr", ".3gp", ".mp3", ".wav", ".txt", ".pdf"] }]
    }
  }
}
